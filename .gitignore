# Python bytecode / caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# generated render output (safe to delete; `vidkit build` recreates it)
.out/
_build/
_capture/
_frames/
*.mp4
*.srt

# scratch / logs
*.log

# scratch directories used by the CI assertions (`_alt` = second window,
# `_scaffold` = `vidkit init` output); recreate with the commands in ci.yml
_alt/
_scaffold/
# scratch story the capture probe builds with a deliberately false assertion
_capture_refusal/

# scratch stories the agent-surface assertion walks init -> build -> verify through
_agent_probe/

# packaging
dist/
build/
*.egg-info/

# editor / OS
.DS_Store
*.swp

# pytest scratch base temp (config.option.basetemp)
.pytest-tmp/
.coverage
